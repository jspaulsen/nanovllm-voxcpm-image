# Copy to .env and edit. Read by docker compose.

# Directory containing your models and LoRA checkpoints. It is mounted read-only at the same path inside
# the container, so absolute symlinks between model directories keep working. Required even when serving
# a Hugging Face repo id.
VOXCPM_MODELS_ROOT=/path/to/models
# Model to serve: a directory under VOXCPM_MODELS_ROOT (config.json, weights, audiovae.pth, tokenizer files)
# or a Hugging Face repo id, which is downloaded into VOXCPM_HF_HOME on first start.
VOXCPM_MODEL=/path/to/models/my-model
# VOXCPM_MODEL=openbmb/VoxCPM2

# Host Hugging Face cache mounted as HF_HOME, e.g. ~/.cache/huggingface to reuse what is already downloaded.
VOXCPM_HF_HOME=./.docker-cache/huggingface
# Set 1 to never contact the Hub (the repo must already be in VOXCPM_HF_HOME).
VOXCPM_HF_HUB_OFFLINE=0

# Host uid/gid the container runs as (`id -u` / `id -g`); must be able to read the model files.
VOXCPM_UID=1000
VOXCPM_GID=1000
# Host directory for HOME and compile caches (Triton / TorchInductor); speeds up restarts.
# Create it (and VOXCPM_HF_HOME) before the first start, or Docker creates them owned by root.
VOXCPM_CACHE_DIR=./.docker-cache

# Host GPU index (see nvidia-smi).
VOXCPM_GPU=1

VOXCPM_PORT=8090
# Fraction of the card's TOTAL memory VoxCPM may use for weights + activations + KV cache
# (0.35 of a 24 GB 3090 is ~8.4 GB). The CUDA context and CUDA graphs add roughly 1 GB on top.
VOXCPM_GPU_MEMORY_UTILIZATION=0.35

# Lower batched tokens = lower warmup memory peak (min 4096). Max concurrent requests.
VOXCPM_MAX_NUM_BATCHED_TOKENS=4096
VOXCPM_MAX_NUM_SEQS=16

# Set true if you will register LoRA adapters via POST /loras.
VOXCPM_LORA_ENABLED=false
# LoRA slot sizing (only used when LoRA is enabled). Adapters must fit: rank <= max rank, and their
# LM/DiT target modules must be a subset of these. Empty targets = all linear layers (more memory).
VOXCPM_LORA_MAX_LORAS=1
VOXCPM_LORA_MAX_LORA_RANK=32
VOXCPM_LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj
# LoRA checkpoint directories must also live under VOXCPM_MODELS_ROOT to be visible in the container.
